<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1220.0" styleClass="app-root" stylesheets="@bidnow-dark.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Server.Controller.WinnerController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="topbar">
            <padding>
                <Insets bottom="16.0" left="32.0" right="32.0" top="16.0" />
            </padding>
            <Label styleClass="muted" text="BidNow / Winner" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button onAction="#onBack" styleClass="secondary-button" text="Tro lai Dashboard" />
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="18.0">
            <padding>
                <Insets bottom="32.0" left="42.0" right="42.0" top="32.0" />
            </padding>

            <VBox maxWidth="620.0" spacing="20.0" styleClass="card">
                <padding>
                    <Insets bottom="30.0" left="34.0" right="34.0" top="30.0" />
                </padding>

                <VBox spacing="8.0">
                    <Label fx:id="lblTitle" styleClass="page-title" text="Ket qua phien dau gia" />
                    <Label styleClass="page-subtitle" text="Thong tin ket thuc phien va nguoi chien thang neu co." />
                </VBox>

                <GridPane hgap="24.0" vgap="16.0">
                    <Label styleClass="field-name" text="SAN PHAM" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Label fx:id="lblItemName" styleClass="field-value" text="(?)" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label styleClass="field-name" text="GIA THANG" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <Label fx:id="lblWinningPrice" styleClass="accent-value" text="0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label styleClass="field-name" text="NGUOI THANG" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <Label fx:id="lblWinnerId" styleClass="field-value" text="(?)" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                </GridPane>

                <Label fx:id="lblNote" styleClass="page-subtitle" text="" wrapText="true" />

                <HBox alignment="CENTER_RIGHT">
                    <Button onAction="#onBack" styleClass="primary-button" text="Tro lai Dashboard" />
                </HBox>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="topbar">
            <padding>
                <Insets bottom="10.0" left="42.0" right="42.0" top="10.0" />
            </padding>
            <Label styleClass="muted" text="BidNow Desktop | JavaFX 21 | Winner workspace" />
        </HBox>
    </bottom>
</BorderPane>
