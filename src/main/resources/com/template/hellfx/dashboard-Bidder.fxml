<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1220.0" styleClass="app-root" stylesheets="@bidnow-dark.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Server.Controller.DashBoardController">
    <left>
        <VBox prefWidth="250.0" spacing="18.0" styleClass="sidebar">
            <padding>
                <Insets bottom="24.0" left="24.0" right="18.0" top="24.0" />
            </padding>

            <VBox spacing="4.0">
                <Label styleClass="brand" text="BidNow" />
                <Label styleClass="muted" text="Auction Platform" />
            </VBox>

            <VBox spacing="12.0">
                <Label styleClass="section-label" text="BIDDER DASHBOARD" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goHome" styleClass="nav-active" text="Home" />
            </VBox>

            <VBox spacing="8.0">
                <Label styleClass="section-label" text="ACCOUNT" />
                <Label fx:id="sidebarUserLabel" styleClass="field-value" text="-" />
                <Label fx:id="sidebarRoleLabel" styleClass="muted" text="BIDDER" />
            </VBox>

            <VBox spacing="8.0">
                <Label styleClass="section-label" text="LIVE MARKET" />
                <Label fx:id="sidebarLiveLabel" styleClass="accent-value" text="-" />
                <Label styleClass="muted" text="phien dang mo" />
            </VBox>
        </VBox>
    </left>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="topbar">
            <padding>
                <Insets bottom="16.0" left="32.0" right="32.0" top="16.0" />
            </padding>
            <Label styleClass="muted" text="BidNow / Bidder Dashboard" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#goToLogin" styleClass="secondary-button" text="Dang xuat" />
        </HBox>
    </top>

    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets bottom="32.0" left="42.0" right="42.0" top="38.0" />
            </padding>

            <VBox spacing="8.0">
                <Label styleClass="page-title" text="Bidder Dashboard" />
                <Label styleClass="page-subtitle" text="Theo doi phien dau gia, dat gia va quan ly tai khoan cua ban." />
            </VBox>

            <HBox spacing="14.0">
                <VBox prefHeight="78.0" prefWidth="210.0" spacing="8.0" styleClass="card">
                    <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                    </padding>
                    <Label styleClass="field-name" text="SO DU KHA DUNG" />
                    <Label fx:id="availableBalanceLabel" styleClass="money-value" text="-" />
                </VBox>

                <VBox prefHeight="78.0" prefWidth="210.0" spacing="8.0" styleClass="card">
                    <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                    </padding>
                    <Label styleClass="field-name" text="TIEN DANG KHOA" />
                    <Label fx:id="lockedBalanceLabel" styleClass="money-value" text="-" />
                </VBox>

                <VBox prefHeight="78.0" prefWidth="210.0" spacing="8.0" styleClass="card">
                    <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                    </padding>
                    <Label styleClass="field-name" text="STAKE DANG KHOA" />
                    <Label fx:id="activeStakeCountLabel" styleClass="accent-value" text="-" />
                </VBox>

                <VBox prefHeight="78.0" prefWidth="210.0" spacing="8.0" styleClass="card">
                    <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                    </padding>
                    <Label styleClass="field-name" text="DANG DAN DAU" />
                    <Label fx:id="leadingSessionCountLabel" styleClass="success-value" text="-" />
                </VBox>
            </HBox>

            <HBox spacing="18.0" VBox.vgrow="ALWAYS">
                <VBox spacing="18.0" HBox.hgrow="ALWAYS">
                    <HBox spacing="18.0">
                        <VBox prefHeight="150.0" prefWidth="280.0" spacing="12.0" styleClass="card">
                            <padding>
                                <Insets bottom="20.0" left="22.0" right="22.0" top="20.0" />
                            </padding>
                            <Label styleClass="field-name" text="AUCTION FLOOR" />
                            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f4f7fb;" text="San dau gia" />
                            <Label styleClass="page-subtitle" text="Xem cac phien dang chay va tham gia dau gia." wrapText="true" />
                            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#Sandaugia" styleClass="primary-button" text="Vao san ->" />
                        </VBox>

                        <VBox prefHeight="150.0" prefWidth="280.0" spacing="12.0" styleClass="card">
                            <padding>
                                <Insets bottom="20.0" left="22.0" right="22.0" top="20.0" />
                            </padding>
                            <Label styleClass="field-name" text="ACCOUNT" />
                            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f4f7fb;" text="Thong tin tai khoan" />
                            <Label styleClass="page-subtitle" text="Kiem tra so du, tien khoa va lich su stake." wrapText="true" />
                            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#quanlytk" styleClass="secondary-button" text="Mo tai khoan" />
                        </VBox>

                        <VBox prefHeight="150.0" prefWidth="280.0" spacing="12.0" styleClass="card">
                            <padding>
                                <Insets bottom="20.0" left="22.0" right="22.0" top="20.0" />
                            </padding>
                            <Label styleClass="field-name" text="BALANCE" />
                            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f4f7fb;" text="Nap tien" />
                            <Label styleClass="page-subtitle" text="Bo sung so du de tiep tuc dat gia." wrapText="true" />
                            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goToDeposit" styleClass="secondary-button" text="Nap tien" />
                        </VBox>
                    </HBox>

                    <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                        <Label styleClass="section-label" text="LICH SU STAKE GAN DAY" />
                        <TableView fx:id="recentStakeTable" prefHeight="260.0" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="stakeSessionColumn" prefWidth="105.0" text="Auction ID" />
                                <TableColumn fx:id="stakeItemColumn" prefWidth="105.0" text="Item ID" />
                                <TableColumn fx:id="stakeAmountColumn" prefWidth="190.0" text="So tien" />
                                <TableColumn fx:id="stakeStatusColumn" prefWidth="145.0" text="Trang thai" />
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>

                <VBox prefWidth="430.0" spacing="12.0" styleClass="card" HBox.hgrow="NEVER">
                    <padding>
                        <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                    </padding>
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-name" text="PHIEN DANG CHAY" />
                            <Label fx:id="liveSessionSummaryLabel" styleClass="page-subtitle" text="Dang tai du lieu..." />
                        </VBox>
                        <Button mnemonicParsing="false" onAction="#Sandaugia" styleClass="secondary-button" text="Xem tat ca" />
                    </HBox>
                    <TableView fx:id="liveSessionTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="liveItemColumn" prefWidth="120.0" text="Item" />
                            <TableColumn fx:id="livePriceColumn" prefWidth="110.0" text="Gia hien tai" />
                            <TableColumn fx:id="liveLeaderColumn" prefWidth="75.0" text="Leader" />
                            <TableColumn fx:id="liveTimeColumn" prefWidth="85.0" text="Con lai" />
                        </columns>
                    </TableView>

                    <VBox spacing="8.0">
                        <VBox spacing="4.0">
                            <Label styleClass="field-name" text="PHIEN DA KET THUC" />
                            <Label fx:id="endedSessionSummaryLabel" styleClass="page-subtitle" text="Dang tai du lieu..." />
                        </VBox>
                        <TableView fx:id="endedSessionTable" prefHeight="205.0">
                            <columns>
                                <TableColumn fx:id="endedItemColumn" prefWidth="120.0" text="Item" />
                                <TableColumn fx:id="endedPriceColumn" prefWidth="110.0" text="Gia cuoi" />
                                <TableColumn fx:id="endedWinnerColumn" prefWidth="75.0" text="Winner" />
                                <TableColumn fx:id="endedStatusColumn" prefWidth="85.0" text="Trang thai" />
                            </columns>
                        </TableView>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="topbar">
            <padding>
                <Insets bottom="10.0" left="42.0" right="42.0" top="10.0" />
            </padding>
            <Label styleClass="muted" text="BidNow Desktop | JavaFX 21 | Bidder workspace" />
        </HBox>
    </bottom>
</BorderPane>
