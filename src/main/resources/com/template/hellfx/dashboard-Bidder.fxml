<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1220.0" styleClass="app-root" stylesheets="@bidnow-dark.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Server.Controller.dashboard.DashBoardController">
    <left>
        <VBox prefWidth="250.0" spacing="18.0" styleClass="sidebar">
            <padding>
                <Insets bottom="24.0" left="24.0" right="18.0" top="24.0" />
            </padding>

            <VBox spacing="4.0">
                <Label styleClass="brand" text="BidNow" />
                <Label styleClass="muted" text="Auction Platform" />
            </VBox>

            <VBox spacing="12.0">
                <Label styleClass="section-label" text="BẢNG ĐIỀU KHIỂN NGƯỜI ĐẤU GIÁ" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goHome" styleClass="nav-active" text="Home" />
            </VBox>

            <VBox spacing="8.0">
                <Label styleClass="section-label" text="TÀI KHOẢN" />
                <Label fx:id="sidebarUserLabel" styleClass="field-value" text="-" />
                <Label fx:id="sidebarRoleLabel" styleClass="muted" text="BIDDER" />
            </VBox>

            <VBox spacing="8.0">
                <Label styleClass="section-label" text="LIVE MARKET" />
                <Label fx:id="sidebarLiveLabel" styleClass="accent-value" text="-" />
                <Label styleClass="muted" text="phiên đang mở" />
            </VBox>
        </VBox>
    </left>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="topbar">
            <padding>
                <Insets bottom="16.0" left="32.0" right="32.0" top="16.0" />
            </padding>
            <Label styleClass="muted" text="BidNow / Bảng điều khiển Người đấu giá" />
            <HBox HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-background-color: rgba(67, 196, 99, 0.1); -fx-background-radius: 6; -fx-padding: 6 12 6 12;">
                <Label style="-fx-text-fill: #7d8794; -fx-font-size: 11px; -fx-font-weight: bold;" text="SỐ DƯ:" />
                <Label fx:id="topbarBalanceLabel" style="-fx-text-fill: #43c463; -fx-font-size: 13px; -fx-font-weight: bold;" text="-" minWidth="-Infinity" />
            </HBox>
            <Button mnemonicParsing="false" onAction="#goToLogin" styleClass="secondary-button" text="Đăng xuất" />
        </HBox>
    </top>

    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets bottom="32.0" left="42.0" right="42.0" top="38.0" />
            </padding>

            <VBox spacing="8.0">
                <Label styleClass="page-title" text="Bảng điều khiển người đấu giá" />
                <Label styleClass="page-subtitle" text="Theo dõi phiên đấu giá, đặt giá và quản lý tài khoản của bạn." />
            </VBox>

            <HBox spacing="14.0">
                <VBox prefHeight="78.0" prefWidth="235.0" spacing="8.0" styleClass="card">
                    <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                    </padding>
                    <Label styleClass="field-name" text="SỐ DƯ KHẢ DỤNG" />
                    <Label fx:id="availableBalanceLabel" styleClass="money-value" text="-" minWidth="-Infinity" />
                </VBox>

                <VBox prefHeight="78.0" prefWidth="235.0" spacing="8.0" styleClass="card">
                    <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                    </padding>
                    <Label styleClass="field-name" text="TIỀN ĐANG KHÓA" />
                    <Label fx:id="lockedBalanceLabel" styleClass="money-value" text="-" minWidth="-Infinity" />
                </VBox>

                <VBox prefHeight="78.0" prefWidth="235.0" spacing="8.0" styleClass="card">
                    <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                    </padding>
                    <Label styleClass="field-name" text="TIỀN ĐẶT CỌC ĐANG KHÓA" />
                    <Label fx:id="activeStakeCountLabel" styleClass="accent-value" text="-" minWidth="-Infinity" />
                </VBox>

                <VBox prefHeight="78.0" prefWidth="135.0" spacing="8.0" styleClass="card">
                    <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                    </padding>
                    <Label styleClass="field-name" text="ĐANG DẪN ĐẦU" />
                    <Label fx:id="leadingSessionCountLabel" styleClass="success-value" text="-" minWidth="-Infinity" />
                </VBox>
            </HBox>

            <HBox spacing="18.0" VBox.vgrow="ALWAYS">
                <VBox spacing="18.0" HBox.hgrow="ALWAYS">
                    <HBox spacing="18.0">
                        <VBox prefHeight="150.0" prefWidth="280.0" spacing="12.0" styleClass="card">
                            <padding>
                                <Insets bottom="20.0" left="22.0" right="22.0" top="20.0" />
                            </padding>
                            <Label styleClass="field-name" text="SÀN ĐẤU GIÁ" />
                            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f4f7fb;" text="Sàn đấu giá" />
                            <Label styleClass="page-subtitle" text="Xem các phiên đang chạy và tham gia đấu giá." wrapText="true" />
                            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#Sandaugia" styleClass="primary-button" text="Vào sàn ->" />
                        </VBox>

                        <VBox prefHeight="150.0" prefWidth="280.0" spacing="12.0" styleClass="card">
                            <padding>
                                <Insets bottom="20.0" left="22.0" right="22.0" top="20.0" />
                            </padding>
                            <Label styleClass="field-name" text="TÀI KHOẢN" />
                            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f4f7fb;" text="Thong tin tai khoan" />
                            <Label styleClass="page-subtitle" text="Kiểm tra số dư, tiền khóa và lịch sử đặt cọc." wrapText="true" />
                            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#quanlytk" styleClass="secondary-button" text="Mở tài khoản" />
                        </VBox>

                        <VBox prefHeight="150.0" prefWidth="280.0" spacing="12.0" styleClass="card">
                            <padding>
                                <Insets bottom="20.0" left="22.0" right="22.0" top="20.0" />
                            </padding>
                            <Label styleClass="field-name" text="SỐ DƯ" />
                            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f4f7fb;" text="Nạp tiền" />
                            <Label styleClass="page-subtitle" text="Bổ sung số dư để tiếp tục đặt giá." wrapText="true" />
                            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goToDeposit" styleClass="secondary-button" text="Nạp tiền" />
                        </VBox>
                    </HBox>

                    <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label styleClass="section-label" text="PHIÊN ĐANG CHẠY" />
                            <HBox HBox.hgrow="ALWAYS" />
                            <Label fx:id="liveSessionSummaryLabel" styleClass="page-subtitle" text="Đang tải dữ liệu..." />
                            <Button mnemonicParsing="false" onAction="#Sandaugia" styleClass="secondary-button" text="Xem tất cả" />
                        </HBox>
                        <ListView fx:id="liveSessionTable" styleClass="data-list" VBox.vgrow="ALWAYS" />
                    </VBox>
                </VBox>

                <VBox prefWidth="430.0" spacing="12.0" styleClass="card" HBox.hgrow="NEVER">
                    <padding>
                        <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                    </padding>
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-name" text="SẢN PHẨM CỦA TÔI" />
                            <Label fx:id="ownedProductSummaryLabel" styleClass="page-subtitle" text="Đang tải dữ liệu..." />
                        </VBox>
                    </HBox>
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="245.0" styleClass="flat-scroll" VBox.vgrow="ALWAYS">
                        <content>
                            <VBox fx:id="ownedProductList" spacing="10.0" styleClass="product-list" />
                        </content>
                    </ScrollPane>

                    <VBox spacing="8.0">
                        <VBox spacing="4.0">
                            <Label styleClass="field-name" text="PHIÊN ĐÃ KẾT THÚC" />
                            <Label fx:id="endedSessionSummaryLabel" styleClass="page-subtitle" text="Đang tải dữ liệu..." />
                        </VBox>
                        <ListView fx:id="endedSessionTable" prefHeight="205.0" styleClass="data-list" />
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="topbar">
            <padding>
                <Insets bottom="10.0" left="42.0" right="42.0" top="10.0" />
            </padding>
            <Label styleClass="muted" text="BidNow Desktop | JavaFX 21 | Không gian Người đấu giá" />
        </HBox>
    </bottom>
</BorderPane>
