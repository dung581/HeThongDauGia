<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1220.0" styleClass="app-root" stylesheets="@bidnow-dark.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Server.Controller.DepositController">
    <left>
        <VBox prefWidth="250.0" spacing="18.0" styleClass="sidebar">
            <padding>
                <Insets bottom="24.0" left="24.0" right="18.0" top="24.0" />
            </padding>

            <VBox spacing="4.0">
                <Label styleClass="brand" text="BidNow" />
                <Label styleClass="muted" text="Auction Platform" />
            </VBox>

            <VBox spacing="12.0">
                <Label styleClass="section-label" text="ĐIỀU HƯỚNG" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goHome" styleClass="nav-item" text="Home" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goToSessions" styleClass="nav-item" text="Sessions" />
                <Button fx:id="browseItemsNav" maxWidth="Infinity" mnemonicParsing="false" onAction="#goToBrowseItems" styleClass="nav-item" text="Browse Items" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goToAccount" styleClass="nav-item" text="My Account" />
            </VBox>

            <VBox spacing="12.0">
                <Label styleClass="section-label" text="TÀI KHOẢN" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goToDeposit" styleClass="nav-active" text="Deposit" />
                <Button fx:id="uploadItemNav" maxWidth="Infinity" mnemonicParsing="false" onAction="#goToUploadItem" styleClass="nav-item" text="Upload Item" />
            </VBox>
        </VBox>
    </left>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="topbar">
            <padding>
                <Insets bottom="16.0" left="32.0" right="32.0" top="16.0" />
            </padding>
            <Label styleClass="muted" text="BidNow / Nạp tiền" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#onBack" styleClass="secondary-button" text="Trở lại" />
        </HBox>
    </top>

    <center>
        <VBox spacing="24.0">
            <padding>
                <Insets bottom="32.0" left="42.0" right="42.0" top="38.0" />
            </padding>

            <VBox spacing="8.0">
                <Label styleClass="page-title" text="Nạp tiền vào tài khoản" />
                <Label styleClass="page-subtitle" text="Bổ sung số dư khả dụng để tham gia đấu giá và cấu hình tự động đấu giá (auto bid)." />
            </VBox>

            <HBox spacing="14.0">
                <VBox prefHeight="78.0" prefWidth="230.0" spacing="6.0" styleClass="card">
                    <padding><Insets bottom="12.0" left="18.0" right="18.0" top="12.0" /></padding>
                    <Label styleClass="field-name" text="SỐ DƯ HIỆN TẠI" />
                    <Label fx:id="lblBalance" styleClass="money-value" text="0" />
                </VBox>
                <VBox prefHeight="78.0" prefWidth="230.0" spacing="6.0" styleClass="card">
                    <padding><Insets bottom="12.0" left="18.0" right="18.0" top="12.0" /></padding>
                    <Label styleClass="field-name" text="ĐANG KHÓA" />
                    <Label fx:id="lblLocked" styleClass="money-value" text="0" />
                </VBox>
                <VBox prefHeight="78.0" prefWidth="230.0" spacing="6.0" styleClass="card">
                    <padding><Insets bottom="12.0" left="18.0" right="18.0" top="12.0" /></padding>
                    <Label styleClass="field-name" text="KHẢ DỤNG" />
                    <Label fx:id="lblAvailable" styleClass="money-value" text="0" />
                </VBox>
            </HBox>

            <VBox maxWidth="520.0" spacing="16.0" styleClass="card">
                <padding>
                    <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                </padding>
                <VBox spacing="6.0">
                    <Label styleClass="section-label" text="NẠP TIỀN" />
                    <Label styleClass="field-value" text="Nhap so tien can nap vao tai khoan." />
                </VBox>

                <GridPane hgap="14.0" vgap="10.0">
                    <Label styleClass="field-name" text="SỐ TIỀN NẠP" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="depositAmountField" prefWidth="300.0" promptText="Nhap so tien VND" styleClass="input" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                </GridPane>

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <Button mnemonicParsing="false" onAction="#onBack" styleClass="secondary-button" text="Hủy" />
                    <Button mnemonicParsing="false" onAction="#onConfirmDeposit" styleClass="primary-button" text="Xác nhận nạp" />
                </HBox>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="topbar">
            <padding>
                <Insets bottom="10.0" left="42.0" right="42.0" top="10.0" />
            </padding>
            <Label styleClass="muted" text="BidNow Desktop | JavaFX 21 | Nạp tiền vào tài khoản" />
        </HBox>
    </bottom>
</BorderPane>
