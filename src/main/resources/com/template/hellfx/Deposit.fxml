<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: skyblue;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Server.Controller.DepositController">

    <top>
        <Label style="-fx-font-size: 18px; -fx-padding: 10;" text="Nạp tiền vào tài khoản" BorderPane.alignment="CENTER" />
    </top>

    <center>
        <VBox alignment="CENTER" spacing="14.0">
            <padding>
                <Insets bottom="20.0" left="40.0" right="40.0" top="20.0" />
            </padding>

            <GridPane hgap="14.0" vgap="10.0">
                <Label text="Số dư hiện tại:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Label fx:id="lblBalance" style="-fx-font-weight: bold;" text="0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Đang khóa:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Label fx:id="lblLocked" text="0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Khả dụng:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <Label fx:id="lblAvailable" style="-fx-text-fill: green; -fx-font-weight: bold;" text="0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </GridPane>

            <HBox alignment="CENTER" spacing="10.0">
                <Label text="Số tiền nạp:" />
                <TextField fx:id="depositAmountField" prefWidth="200.0" promptText="Nhập số tiền (VND)" />
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="14.0" style="-fx-padding: 14;">
            <Button onAction="#onConfirmDeposit" prefWidth="120.0" style="-fx-background-color: green; -fx-text-fill: white;" text="Xác nhận nạp" />
            <Button onAction="#onBack" prefWidth="120.0" text="Trở lại" />
        </HBox>
    </bottom>

</BorderPane>