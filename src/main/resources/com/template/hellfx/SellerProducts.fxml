<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1220.0" styleClass="app-root" stylesheets="@bidnow-dark.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Server.Controller.SellerProductController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="topbar">
            <padding>
                <Insets bottom="16.0" left="32.0" right="32.0" top="16.0" />
            </padding>
            <Label styleClass="muted" text="BidNow / Seller / Upload Item" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#backToSellerDashboard" styleClass="secondary-button" text="Trở lại" />
        </HBox>
    </top>

    <center>
        <HBox spacing="22.0">
            <padding>
                <Insets bottom="24.0" left="32.0" right="32.0" top="28.0" />
            </padding>

            <VBox prefWidth="330.0" spacing="18.0">
                <VBox spacing="6.0">
                    <Label styleClass="page-title" text="Dang ban san pham" />
                    <Label styleClass="page-subtitle" text="Gui item cho admin duyet truoc khi mo phien dau gia." wrapText="true" />
                </VBox>

                <VBox spacing="12.0" styleClass="card">
                    <padding>
                        <Insets bottom="22.0" left="22.0" right="22.0" top="22.0" />
                    </padding>

                    <Label styleClass="section-label" text="NEW ITEM" />
                    <VBox spacing="8.0">
                        <Label styleClass="field-name" text="TEN SAN PHAM" />
                        <TextField fx:id="itemName" promptText="Nhap ten" styleClass="input" />
                    </VBox>
                    <VBox spacing="8.0">
                        <Label styleClass="field-name" text="GIA KHOI DIEM" />
                        <TextField fx:id="itemPrice" promptText="Nhap gia" styleClass="input" />
                    </VBox>
                    <VBox spacing="8.0">
                        <Label styleClass="field-name" text="BUOC GIA TOI THIEU" />
                        <TextField fx:id="itemMinIncrement" promptText="VD: 10" styleClass="input" />
                    </VBox>
                    <VBox spacing="8.0">
                        <Label styleClass="field-name" text="MO TA" />
                        <TextField fx:id="itemDescription" promptText="Nhap mo ta" styleClass="input" />
                    </VBox>
                    <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#submitItem" styleClass="primary-button" text="Gui duyet" />
                </VBox>
            </VBox>

            <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                <VBox spacing="6.0">
                    <Label styleClass="page-title" text="San pham cua toi" />
                    <Label styleClass="page-subtitle" text="Theo doi trang thai item da gui va phan hoi tu admin." />
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-bar">
                    <TextField fx:id="searchField" prefWidth="300.0" promptText="Tim ten, ID, ghi chu" styleClass="input" />
                    <ChoiceBox fx:id="statusFilter" prefWidth="170.0" />
                    <Button mnemonicParsing="false" onAction="#loadMyItems" styleClass="secondary-button" text="Tải lại" />
                </HBox>

                <ListView fx:id="table" styleClass="data-list" VBox.vgrow="ALWAYS" />
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="topbar">
            <padding>
                <Insets bottom="10.0" left="42.0" right="42.0" top="10.0" />
            </padding>
            <Label styleClass="muted" text="BidNow Desktop | JavaFX 21 | Seller item workspace" />
        </HBox>
    </bottom>
</BorderPane>
