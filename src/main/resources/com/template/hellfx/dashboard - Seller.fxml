<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1220.0" styleClass="app-root" stylesheets="@bidnow-dark.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Server.Controller.DashBoardController">
    <left>
        <VBox prefWidth="250.0" spacing="18.0" styleClass="sidebar">
            <padding>
                <Insets bottom="24.0" left="24.0" right="18.0" top="24.0" />
            </padding>

            <VBox spacing="4.0">
                <Label styleClass="brand" text="BidNow" />
                <Label styleClass="muted" text="Seller Workspace" />
            </VBox>

            <VBox spacing="12.0">
                <Label styleClass="section-label" text="SELLER DASHBOARD" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goHome" styleClass="nav-active" text="Home" />
            </VBox>

            <VBox spacing="8.0">
                <Label styleClass="section-label" text="ACCOUNT" />
                <Label fx:id="sellerSidebarUserLabel" styleClass="field-value" text="-" />
                <Label fx:id="sellerSidebarRoleLabel" styleClass="muted" text="SELLER" />
            </VBox>

            <VBox spacing="8.0">
                <Label styleClass="section-label" text="INVENTORY" />
                <Label fx:id="sellerSidebarItemsLabel" styleClass="accent-value" text="-" />
                <Label styleClass="muted" text="item cua ban" />
            </VBox>
        </VBox>
    </left>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="topbar">
            <padding>
                <Insets bottom="16.0" left="32.0" right="32.0" top="16.0" />
            </padding>
            <Label styleClass="muted" text="BidNow / Seller Dashboard" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#goToLogin" styleClass="secondary-button" text="Dang xuat" />
        </HBox>
    </top>

    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets bottom="32.0" left="42.0" right="42.0" top="38.0" />
            </padding>

            <VBox spacing="8.0">
                <Label styleClass="page-title" text="Seller Dashboard" />
                <Label styleClass="page-subtitle" text="Theo doi item dang ban, trang thai duyet va ket qua dau gia cua ban." />
            </VBox>

            <HBox spacing="14.0">
                <VBox prefHeight="78.0" prefWidth="210.0" spacing="8.0" styleClass="card">
                    <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                    </padding>
                    <Label styleClass="field-name" text="TONG ITEM" />
                    <Label fx:id="sellerTotalItemsLabel" styleClass="accent-value" text="-" />
                </VBox>

                <VBox prefHeight="78.0" prefWidth="210.0" spacing="8.0" styleClass="card">
                    <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                    </padding>
                    <Label styleClass="field-name" text="CHO DUYET" />
                    <Label fx:id="sellerPendingItemsLabel" styleClass="danger-value" text="-" />
                </VBox>

                <VBox prefHeight="78.0" prefWidth="210.0" spacing="8.0" styleClass="card">
                    <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                    </padding>
                    <Label styleClass="field-name" text="DANG DAU GIA" />
                    <Label fx:id="sellerInAuctionItemsLabel" styleClass="success-value" text="-" />
                </VBox>

                <VBox prefHeight="78.0" prefWidth="210.0" spacing="8.0" styleClass="card">
                    <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                    </padding>
                    <Label styleClass="field-name" text="DA BAN" />
                    <Label fx:id="sellerSoldItemsLabel" styleClass="success-value" text="-" />
                </VBox>
            </HBox>

            <HBox spacing="18.0">
                <VBox prefHeight="145.0" prefWidth="280.0" spacing="12.0" styleClass="card">
                    <padding>
                        <Insets bottom="20.0" left="22.0" right="22.0" top="20.0" />
                    </padding>
                    <Label styleClass="field-name" text="UPLOAD" />
                    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f4f7fb;" text="Dang ban san pham" />
                    <Label styleClass="page-subtitle" text="Gui item moi cho admin kiem duyet." wrapText="true" />
                    <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#dangban" styleClass="primary-button" text="Mo san pham ->" />
                </VBox>

                <VBox prefHeight="145.0" prefWidth="280.0" spacing="12.0" styleClass="card">
                    <padding>
                        <Insets bottom="20.0" left="22.0" right="22.0" top="20.0" />
                    </padding>
                    <Label styleClass="field-name" text="AUCTION FLOOR" />
                    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f4f7fb;" text="San dau gia" />
                    <Label styleClass="page-subtitle" text="Xem phien dang chay va ket qua dau gia." wrapText="true" />
                    <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#Sandaugia" styleClass="secondary-button" text="Vao san" />
                </VBox>

                <VBox prefHeight="145.0" prefWidth="280.0" spacing="12.0" styleClass="card">
                    <padding>
                        <Insets bottom="20.0" left="22.0" right="22.0" top="20.0" />
                    </padding>
                    <Label styleClass="field-name" text="ACCOUNT" />
                    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f4f7fb;" text="Thong tin tai khoan" />
                    <Label styleClass="page-subtitle" text="Kiem tra thong tin seller va lich su lien quan." wrapText="true" />
                    <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#quanlytk" styleClass="secondary-button" text="Mo tai khoan" />
                </VBox>
            </HBox>

            <HBox spacing="18.0" VBox.vgrow="ALWAYS">
                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="section-label" text="ITEM CUA BAN" />
                    <Label fx:id="sellerItemSummaryLabel" styleClass="page-subtitle" text="Dang tai du lieu..." />
                    <TableView fx:id="sellerItemTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="sellerItemIdColumn" prefWidth="80.0" text="ID" />
                            <TableColumn fx:id="sellerItemNameColumn" prefWidth="190.0" text="Ten" />
                            <TableColumn fx:id="sellerItemPriceColumn" prefWidth="150.0" text="Gia khoi diem" />
                            <TableColumn fx:id="sellerItemStatusColumn" prefWidth="140.0" text="Trang thai" />
                        </columns>
                    </TableView>
                </VBox>

                <VBox prefWidth="450.0" spacing="10.0">
                    <Label styleClass="section-label" text="PHIEN LIEN QUAN" />
                    <Label fx:id="sellerSessionSummaryLabel" styleClass="page-subtitle" text="Dang tai du lieu..." />
                    <TableView fx:id="sellerSessionTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="sellerSessionItemColumn" prefWidth="150.0" text="Item" />
                            <TableColumn fx:id="sellerSessionPriceColumn" prefWidth="120.0" text="Gia hien tai" />
                            <TableColumn fx:id="sellerSessionLeaderColumn" prefWidth="80.0" text="Leader" />
                            <TableColumn fx:id="sellerSessionStatusColumn" prefWidth="95.0" text="Trang thai" />
                        </columns>
                    </TableView>
                </VBox>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="topbar">
            <padding>
                <Insets bottom="10.0" left="42.0" right="42.0" top="10.0" />
            </padding>
            <Label styleClass="muted" text="BidNow Desktop | JavaFX 21 | Seller workspace" />
        </HBox>
    </bottom>
</BorderPane>
