<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: skyblue;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Server.Controller.ItemBrowseController">

    <top>
        <VBox spacing="6" style="-fx-padding: 10;">
            <Label style="-fx-font-size: 18px;" text="Danh sách sản phẩm" />
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="lblRole" text="Vai trò: ?" />
                <Label text="Lọc theo trạng thái:" />
                <ChoiceBox fx:id="statusFilter" prefWidth="160.0" />
                <Label fx:id="lblTotal" text="Tổng: 0 sản phẩm" />
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="table">
            <columns>
                <TableColumn fx:id="colId" prefWidth="60" text="ID" />
                <TableColumn fx:id="colName" prefWidth="160.0" text="Tên" />
                <TableColumn fx:id="colPrice" prefWidth="100.0" text="Giá khởi điểm" />
                <TableColumn fx:id="colDescription" prefWidth="240.0" text="Thông tin" />
                <TableColumn fx:id="colNote" prefWidth="120.0" text="Mô tả" />
                <TableColumn fx:id="colStatus" prefWidth="120.0" text="Trạng thái" />
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="8" style="-fx-padding: 10;">
            <HBox fx:id="adminInputBox" alignment="CENTER_LEFT" spacing="8">
                <Label text="Lý do từ chối:" />
                <TextField fx:id="rejectReason" prefWidth="220.0" promptText="Nhập lý do" />
                <Label text="Số giờ đấu giá:" />
                <TextField fx:id="endTime" prefWidth="120.0" promptText="VD: 24" />
            </HBox>
            <HBox alignment="CENTER" spacing="10">
                <Button onAction="#loadData" text="Tải lại" />
                <HBox fx:id="adminActionBox" alignment="CENTER" spacing="10">
                    <Button onAction="#onApprove" text="Duyệt + Mở phiên" />
                    <Button onAction="#onReject" text="Từ chối" />
                    <Button onAction="#onCreateSession" text="Mở phiên (APPROVED)" />
                </HBox>
                <Button onAction="#onBack" text="Trở lại" />
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
