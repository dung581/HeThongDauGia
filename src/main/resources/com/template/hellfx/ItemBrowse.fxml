<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1220.0" styleClass="app-root" stylesheets="@bidnow-dark.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Server.Controller.ItemBrowseController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="topbar">
            <padding>
                <Insets bottom="16.0" left="32.0" right="32.0" top="16.0" />
            </padding>
            <Label styleClass="muted" text="BidNow / Items" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button onAction="#onBack" styleClass="secondary-button" text="Tro lai" />
        </HBox>
    </top>

    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets bottom="24.0" left="32.0" right="32.0" top="28.0" />
            </padding>

            <VBox spacing="6.0">
                <Label styleClass="page-title" text="Danh sach san pham" />
                <Label styleClass="page-subtitle" text="Loc item theo trang thai va xu ly tac vu duyet rieng cho admin." />
            </VBox>

            <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="card">
                <padding>
                    <Insets bottom="14.0" left="18.0" right="18.0" top="14.0" />
                </padding>
                <Label fx:id="lblRole" styleClass="field-value" text="Vai tro: ?" />
                <Label styleClass="field-name" text="TRANG THAI" />
                <ChoiceBox fx:id="statusFilter" prefWidth="180.0" styleClass="input" />
                <HBox HBox.hgrow="ALWAYS" />
                <Label fx:id="lblTotal" styleClass="field-value" text="Tong: 0 san pham" />
            </HBox>

            <TableView fx:id="table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="80.0" text="ID" />
                    <TableColumn fx:id="colName" prefWidth="190.0" text="Ten" />
                    <TableColumn fx:id="colPrice" prefWidth="140.0" text="Gia khoi diem" />
                    <TableColumn fx:id="colDescription" prefWidth="340.0" text="Thong tin" />
                    <TableColumn fx:id="colNote" prefWidth="230.0" text="Mo ta" />
                    <TableColumn fx:id="colStatus" prefWidth="160.0" text="Trang thai" />
                </columns>
            </TableView>

            <VBox spacing="12.0">
                <HBox fx:id="adminInputBox" alignment="CENTER_LEFT" spacing="10.0" styleClass="card">
                    <padding>
                        <Insets bottom="14.0" left="18.0" right="18.0" top="14.0" />
                    </padding>
                    <Label styleClass="field-name" text="LY DO TU CHOI" />
                    <TextField fx:id="rejectReason" prefWidth="260.0" promptText="Nhap ly do" styleClass="input" />
                    <Label styleClass="field-name" text="SO GIO DAU GIA" />
                    <TextField fx:id="endTime" prefWidth="140.0" promptText="VD: 24" styleClass="input" />
                </HBox>

                <HBox alignment="CENTER" spacing="10.0">
                    <Button onAction="#loadData" styleClass="secondary-button" text="Tai lai" />
                    <HBox fx:id="adminActionBox" alignment="CENTER" spacing="10.0">
                        <Button onAction="#onApprove" styleClass="primary-button" text="Duyet + Mo phien" />
                        <Button onAction="#onReject" styleClass="danger-button" text="Tu choi" />
                        <Button onAction="#onCreateSession" styleClass="secondary-button" text="Mo phien APPROVED" />
                    </HBox>
                    <Button onAction="#onBack" styleClass="secondary-button" text="Tro lai" />
                </HBox>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="topbar">
            <padding>
                <Insets bottom="10.0" left="42.0" right="42.0" top="10.0" />
            </padding>
            <Label styleClass="muted" text="BidNow Desktop | JavaFX 21 | Item browser" />
        </HBox>
    </bottom>
</BorderPane>
