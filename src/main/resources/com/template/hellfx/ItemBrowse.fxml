<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1220.0" styleClass="app-root" stylesheets="@bidnow-dark.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Server.Controller.ItemBrowseController">
    <left>
        <VBox prefWidth="250.0" spacing="18.0" styleClass="sidebar">
            <padding>
                <Insets bottom="24.0" left="24.0" right="18.0" top="24.0" />
            </padding>

            <VBox spacing="4.0">
                <Label styleClass="brand" text="BidNow" />
                <Label styleClass="muted" text="Item Workspace" />
            </VBox>

            <VBox spacing="12.0">
                <Label styleClass="section-label" text="ITEM MANAGEMENT" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onBack" styleClass="nav-item" text="Home" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#loadData" styleClass="nav-active" text="Danh sách sản phẩm" />
            </VBox>

            <VBox spacing="8.0">
                <Label styleClass="section-label" text="CURRENT ROLE" />
                <Label fx:id="lblRole" styleClass="field-value" text="Vai trò: ?" />
                <Label fx:id="lblTotal" styleClass="accent-value" text="0" />
                <Label styleClass="muted" text="sản phẩm đang hiển thị" />
            </VBox>
        </VBox>
    </left>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="topbar">
            <padding>
                <Insets bottom="16.0" left="32.0" right="32.0" top="16.0" />
            </padding>
            <Label styleClass="muted" text="BidNow / Danh sách vật phẩm" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#onBack" styleClass="secondary-button" text="Trở lại" />
        </HBox>
    </top>

    <center>
        <HBox spacing="24.0">
            <padding>
                <Insets bottom="28.0" left="34.0" right="24.0" top="30.0" />
            </padding>

            <VBox spacing="18.0" HBox.hgrow="ALWAYS">
                <VBox spacing="6.0">
                    <Label styleClass="page-title" text="Danh sách sản phẩm" />
                    <Label styleClass="page-subtitle" text="Lọc trạng thái, xem mô tả và xử lý duyệt/mở phiên từ một màn duy nhất." wrapText="true" />
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="filter-bar">
                    <Label styleClass="field-name" text="TRẠNG THÁI" />
                    <ChoiceBox fx:id="statusFilter" prefWidth="180.0" styleClass="input" />
                    <HBox HBox.hgrow="ALWAYS" />
                    <Button mnemonicParsing="false" onAction="#loadData" styleClass="secondary-button" text="Tải lại" />
                </HBox>

                <ListView fx:id="table" styleClass="data-list" VBox.vgrow="ALWAYS" />
            </VBox>

            <VBox fx:id="adminInputBox" prefWidth="330.0" spacing="14.0" styleClass="card">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>

                <VBox spacing="6.0">
                    <Label styleClass="section-label" text="ADMIN ACTIONS" />
                    <Label styleClass="page-subtitle" text="Chọn một sản phẩm trong danh sách rồi thực hiện tác vụ." wrapText="true" />
                </VBox>

                <VBox spacing="8.0">
                    <Label styleClass="field-name" text="LÝ DO TỪ CHỐI" />
                    <TextField fx:id="rejectReason" promptText="Nhập lý do" styleClass="input" />
                </VBox>

                <VBox spacing="8.0">
                    <Label styleClass="field-name" text="SỐ GIỜ ĐẤU GIÁ" />
                    <TextField fx:id="endTime" promptText="VD: 24" styleClass="input" />
                </VBox>

                <VBox fx:id="adminActionBox" spacing="10.0">
                    <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onApprove" styleClass="primary-button" text="Duyệt + Mở phiên" />
                    <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onCreateSession" styleClass="secondary-button" text="Mở phiên APPROVED" />
                    <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onReject" styleClass="danger-button" text="Từ chối" />
                </VBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
