<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1220.0" styleClass="app-root" stylesheets="@bidnow-dark.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Server.Controller.DashBoardController">
    <left>
        <VBox prefWidth="250.0" spacing="18.0" styleClass="sidebar">
            <padding>
                <Insets bottom="24.0" left="24.0" right="18.0" top="24.0" />
            </padding>

            <VBox spacing="4.0">
                <Label styleClass="brand" text="BidNow" />
                <Label styleClass="muted" text="Admin Workspace" />
            </VBox>

            <VBox spacing="12.0">
                <Label styleClass="section-label" text="ADMIN DASHBOARD" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goHome" styleClass="nav-active" text="Home" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#Sandaugia" styleClass="nav-item" text="Sessions" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#duyetsp" styleClass="nav-item" text="Pending Items" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#quanlyvatpham" styleClass="nav-item" text="Item Management" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#quanlytk" styleClass="nav-item" text="Account Management" />
            </VBox>

            <VBox spacing="12.0">
                <Label styleClass="section-label" text="SESSION" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goToLogin" styleClass="nav-item" text="Dang xuat" />
            </VBox>
        </VBox>
    </left>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="topbar">
            <padding>
                <Insets bottom="16.0" left="32.0" right="32.0" top="16.0" />
            </padding>
            <Label styleClass="muted" text="BidNow / Admin Dashboard" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#goToLogin" styleClass="secondary-button" text="Dang xuat" />
        </HBox>
    </top>

    <center>
        <VBox spacing="24.0">
            <padding>
                <Insets bottom="32.0" left="42.0" right="42.0" top="38.0" />
            </padding>

            <VBox spacing="8.0">
                <Label styleClass="page-title" text="Admin Dashboard" />
                <Label styleClass="page-subtitle" text="Quan ly phien dau gia, duyet san pham va theo doi tai khoan trong he thong." />
            </VBox>

            <HBox spacing="18.0">
                <VBox prefHeight="165.0" prefWidth="260.0" spacing="12.0" styleClass="card">
                    <padding>
                        <Insets bottom="22.0" left="22.0" right="22.0" top="22.0" />
                    </padding>
                    <Label styleClass="field-name" text="AUCTION FLOOR" />
                    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f4f7fb;" text="San dau gia" />
                    <Label styleClass="page-subtitle" text="Xem cac phien dang chay va trang thai dau gia hien tai." wrapText="true" />
                    <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#Sandaugia" styleClass="primary-button" text="Mo san ->" />
                </VBox>

                <VBox prefHeight="165.0" prefWidth="260.0" spacing="12.0" styleClass="card">
                    <padding>
                        <Insets bottom="22.0" left="22.0" right="22.0" top="22.0" />
                    </padding>
                    <Label styleClass="field-name" text="APPROVAL" />
                    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f4f7fb;" text="San pham dang ban" />
                    <Label styleClass="page-subtitle" text="Duyet item seller gui len va tao phien dau gia moi." wrapText="true" />
                    <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#duyetsp" styleClass="secondary-button" text="Duyet san pham" />
                </VBox>

                <VBox prefHeight="165.0" prefWidth="260.0" spacing="12.0" styleClass="card">
                    <padding>
                        <Insets bottom="22.0" left="22.0" right="22.0" top="22.0" />
                    </padding>
                    <Label styleClass="field-name" text="INVENTORY" />
                    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f4f7fb;" text="Quan ly vat pham" />
                    <Label styleClass="page-subtitle" text="Kiem tra toan bo item theo trang thai va nguoi ban." wrapText="true" />
                    <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#quanlyvatpham" styleClass="secondary-button" text="Mo danh sach" />
                </VBox>
            </HBox>

            <HBox spacing="18.0">
                <VBox prefHeight="165.0" prefWidth="260.0" spacing="12.0" styleClass="card">
                    <padding>
                        <Insets bottom="22.0" left="22.0" right="22.0" top="22.0" />
                    </padding>
                    <Label styleClass="field-name" text="ACCOUNTS" />
                    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f4f7fb;" text="Quan ly tai khoan" />
                    <Label styleClass="page-subtitle" text="Xem thong tin user, so du va tien dang khoa." wrapText="true" />
                    <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#quanlytk" styleClass="secondary-button" text="Mo tai khoan" />
                </VBox>

                <VBox prefHeight="165.0" prefWidth="260.0" spacing="12.0" styleClass="card">
                    <padding>
                        <Insets bottom="22.0" left="22.0" right="22.0" top="22.0" />
                    </padding>
                    <Label styleClass="field-name" text="SESSION" />
                    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f4f7fb;" text="Dang xuat" />
                    <Label styleClass="page-subtitle" text="Ket thuc phien lam viec admin va quay lai man dang nhap." wrapText="true" />
                    <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goToLogin" styleClass="danger-button" text="Dang xuat" />
                </VBox>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="topbar">
            <padding>
                <Insets bottom="10.0" left="42.0" right="42.0" top="10.0" />
            </padding>
            <Label styleClass="muted" text="BidNow Desktop | JavaFX 21 | Admin workspace" />
        </HBox>
    </bottom>
</BorderPane>
