<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1220.0" styleClass="app-root" stylesheets="@bidnow-dark.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Server.Controller.DashBoardController">
    <left>
        <VBox prefWidth="250.0" spacing="18.0" styleClass="sidebar">
            <padding>
                <Insets bottom="24.0" left="24.0" right="18.0" top="24.0" />
            </padding>

            <VBox spacing="4.0">
                <Label styleClass="brand" text="BidNow" />
                <Label styleClass="muted" text="Admin Workspace" />
            </VBox>

            <VBox spacing="12.0">
                <Label styleClass="section-label" text="ADMIN DASHBOARD" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goHome" styleClass="nav-active" text="Home" />
            </VBox>

            <VBox spacing="12.0">
                <Label styleClass="section-label" text="MANAGEMENT" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#Sandaugia" styleClass="nav-item" text="Sessions" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#duyetsp" styleClass="nav-item" text="Pending Items" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#quanlyvatpham" styleClass="nav-item" text="Item Management" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#quanlytk" styleClass="nav-item" text="Account Management" />
            </VBox>

            <VBox spacing="8.0">
                <Label styleClass="section-label" text="OPERATION" />
                <Label fx:id="adminSidebarUserLabel" styleClass="field-value" text="-" />
                <Label fx:id="adminSidebarPendingLabel" styleClass="accent-value" text="-" />
                <Label styleClass="muted" text="item dang cho duyet" />
            </VBox>
        </VBox>
    </left>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="topbar">
            <padding>
                <Insets bottom="16.0" left="32.0" right="32.0" top="16.0" />
            </padding>
            <Label styleClass="muted" text="BidNow / Admin Dashboard" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#goToLogin" styleClass="secondary-button" text="Dang xuat" />
        </HBox>
    </top>

    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets bottom="32.0" left="42.0" right="42.0" top="38.0" />
            </padding>

            <VBox spacing="8.0">
                <Label styleClass="page-title" text="Admin Dashboard" />
                <Label styleClass="page-subtitle" text="Theo doi van hanh dau gia, duyet item va quan ly du lieu he thong." />
            </VBox>

            <HBox spacing="14.0">
                <VBox prefHeight="78.0" prefWidth="210.0" spacing="8.0" styleClass="card">
                    <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                    </padding>
                    <Label styleClass="field-name" text="PHIEN DANG CHAY" />
                    <Label fx:id="adminActiveSessionsLabel" styleClass="accent-value" text="-" />
                </VBox>

                <VBox prefHeight="78.0" prefWidth="210.0" spacing="8.0" styleClass="card">
                    <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                    </padding>
                    <Label styleClass="field-name" text="CHO DUYET" />
                    <Label fx:id="adminPendingItemsLabel" styleClass="danger-value" text="-" />
                </VBox>

                <VBox prefHeight="78.0" prefWidth="210.0" spacing="8.0" styleClass="card">
                    <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                    </padding>
                    <Label styleClass="field-name" text="TONG ITEM" />
                    <Label fx:id="adminTotalItemsLabel" styleClass="success-value" text="-" />
                </VBox>

                <VBox prefHeight="78.0" prefWidth="210.0" spacing="8.0" styleClass="card">
                    <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                    </padding>
                    <Label styleClass="field-name" text="TAI KHOAN" />
                    <Label fx:id="adminTotalUsersLabel" styleClass="success-value" text="-" />
                </VBox>
            </HBox>

            <HBox spacing="18.0">
                <VBox prefHeight="145.0" prefWidth="280.0" spacing="12.0" styleClass="card">
                    <padding>
                        <Insets bottom="20.0" left="22.0" right="22.0" top="20.0" />
                    </padding>
                    <Label styleClass="field-name" text="APPROVAL" />
                    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f4f7fb;" text="Duyet san pham" />
                    <Label styleClass="page-subtitle" text="Xu ly item seller gui len va mo phien dau gia moi." wrapText="true" />
                    <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#duyetsp" styleClass="primary-button" text="Mo hang doi ->" />
                </VBox>

                <VBox prefHeight="145.0" prefWidth="280.0" spacing="12.0" styleClass="card">
                    <padding>
                        <Insets bottom="20.0" left="22.0" right="22.0" top="20.0" />
                    </padding>
                    <Label styleClass="field-name" text="INVENTORY" />
                    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f4f7fb;" text="Quan ly vat pham" />
                    <Label styleClass="page-subtitle" text="Kiem tra item theo trang thai, gia va nguoi ban." wrapText="true" />
                    <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#quanlyvatpham" styleClass="secondary-button" text="Mo item" />
                </VBox>

                <VBox prefHeight="145.0" prefWidth="280.0" spacing="12.0" styleClass="card">
                    <padding>
                        <Insets bottom="20.0" left="22.0" right="22.0" top="20.0" />
                    </padding>
                    <Label styleClass="field-name" text="ACCOUNTS" />
                    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f4f7fb;" text="Quan ly tai khoan" />
                    <Label styleClass="page-subtitle" text="Xem role, so du va tien dang khoa cua user." wrapText="true" />
                    <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#quanlytk" styleClass="secondary-button" text="Mo tai khoan" />
                </VBox>
            </HBox>

            <HBox spacing="18.0" VBox.vgrow="ALWAYS">
                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="section-label" text="PHIEN DAU GIA GAN DAY" />
                    <Label fx:id="adminSessionSummaryLabel" styleClass="page-subtitle" text="Dang tai du lieu..." />
                    <TableView fx:id="adminSessionTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="adminSessionItemColumn" prefWidth="180.0" text="Item" />
                            <TableColumn fx:id="adminSessionPriceColumn" prefWidth="150.0" text="Gia hien tai" />
                            <TableColumn fx:id="adminSessionLeaderColumn" prefWidth="100.0" text="Leader" />
                            <TableColumn fx:id="adminSessionStatusColumn" prefWidth="130.0" text="Trang thai" />
                        </columns>
                    </TableView>
                </VBox>

                <VBox prefWidth="450.0" spacing="10.0">
                    <Label styleClass="section-label" text="ITEM CAN DUYET" />
                    <Label fx:id="adminPendingSummaryLabel" styleClass="page-subtitle" text="Dang tai du lieu..." />
                    <TableView fx:id="adminPendingItemTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="adminPendingIdColumn" prefWidth="70.0" text="ID" />
                            <TableColumn fx:id="adminPendingNameColumn" prefWidth="150.0" text="Ten" />
                            <TableColumn fx:id="adminPendingSellerColumn" prefWidth="90.0" text="Seller" />
                            <TableColumn fx:id="adminPendingPriceColumn" prefWidth="120.0" text="Gia" />
                        </columns>
                    </TableView>
                </VBox>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="topbar">
            <padding>
                <Insets bottom="10.0" left="42.0" right="42.0" top="10.0" />
            </padding>
            <Label styleClass="muted" text="BidNow Desktop | JavaFX 21 | Admin workspace" />
        </HBox>
    </bottom>
</BorderPane>
