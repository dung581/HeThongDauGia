<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1220.0" styleClass="app-root" stylesheets="@bidnow-dark.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Server.Controller.AdminItemManagementController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="topbar">
            <padding>
                <Insets bottom="16.0" left="32.0" right="32.0" top="16.0" />
            </padding>
            <Label styleClass="muted" text="BidNow / Admin / Item Management" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#backToAdminDashboard" styleClass="secondary-button" text="Tro lai" />
        </HBox>
    </top>

    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets bottom="24.0" left="32.0" right="32.0" top="28.0" />
            </padding>

            <VBox spacing="6.0">
                <Label styleClass="page-title" text="Quan ly vat pham" />
                <Label styleClass="page-subtitle" text="Theo doi tat ca san pham trong he thong theo nguoi ban, gia va trang thai." />
            </VBox>

            <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                <Label styleClass="section-label" text="ALL ITEMS" />
                <TableView fx:id="table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="80.0" text="ID" />
                        <TableColumn fx:id="colName" prefWidth="190.0" text="Ten vat pham" />
                        <TableColumn fx:id="colOwnerId" prefWidth="120.0" text="ID nguoi ban" />
                        <TableColumn fx:id="colPrice" prefWidth="140.0" text="Gia khoi diem" />
                        <TableColumn fx:id="colStatus" prefWidth="140.0" text="Trang thai" />
                        <TableColumn fx:id="colDescription" prefWidth="270.0" text="Mo ta" />
                        <TableColumn fx:id="colReason" prefWidth="260.0" text="Thong tin phan hoi" />
                    </columns>
                </TableView>
            </VBox>

            <HBox alignment="CENTER" spacing="10.0">
                <Button mnemonicParsing="false" onAction="#loadAllItems" styleClass="secondary-button" text="Tai lai" />
                <Button mnemonicParsing="false" onAction="#goFirstPage" styleClass="secondary-button" text="Dau" />
                <Button mnemonicParsing="false" onAction="#goPrevPage" styleClass="secondary-button" text="&lt;" />
                <Label fx:id="lblPageInfo" styleClass="field-value" text="Trang 1 / 1" />
                <Button mnemonicParsing="false" onAction="#goNextPage" styleClass="secondary-button" text="&gt;" />
                <Button mnemonicParsing="false" onAction="#goLastPage" styleClass="secondary-button" text="Cuoi" />
                <TextField fx:id="txtPageInput" prefWidth="90.0" promptText="So trang" styleClass="input" />
                <Button mnemonicParsing="false" onAction="#goToPage" styleClass="secondary-button" text="Di chuyen" />
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="topbar">
            <padding>
                <Insets bottom="10.0" left="42.0" right="42.0" top="10.0" />
            </padding>
            <Label styleClass="muted" text="BidNow Desktop | JavaFX 21 | Admin item workspace" />
        </HBox>
    </bottom>
</BorderPane>
