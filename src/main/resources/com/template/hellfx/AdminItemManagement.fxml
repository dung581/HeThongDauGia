<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1220.0" styleClass="app-root" stylesheets="@bidnow-dark.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Server.Controller.AdminItemManagementController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="topbar">
            <padding>
                <Insets bottom="16.0" left="32.0" right="32.0" top="16.0" />
            </padding>
            <Label styleClass="muted" text="BidNow / Admin / Quản lý vật phẩm" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#backToAdminDashboard" styleClass="secondary-button" text="Trở lại" />
        </HBox>
    </top>

    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets bottom="24.0" left="32.0" right="32.0" top="28.0" />
            </padding>

            <VBox spacing="6.0">
                <Label styleClass="page-title" text="Quản lý vật phẩm" />
                <Label styleClass="page-subtitle" text="Theo dõi tất cả sản phẩm trong hệ thống theo người bán, giá và trạng thái." />
            </VBox>

            <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                <Label styleClass="section-label" text="TẤT CẢ VẬT PHẨM" />
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-bar">
                    <TextField fx:id="searchField" prefWidth="300.0" promptText="Tim ten, ID, mo ta" styleClass="input" />
                    <ChoiceBox fx:id="statusFilter" prefWidth="170.0" />
                    <TextField fx:id="ownerSearchField" prefWidth="160.0" promptText="ID nguoi ban" styleClass="input" />
                    <Button mnemonicParsing="false" onAction="#loadAllItems" styleClass="secondary-button" text="Tải lại" />
                </HBox>
                <ListView fx:id="table" styleClass="data-list" VBox.vgrow="ALWAYS" />
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="topbar">
            <padding>
                <Insets bottom="10.0" left="42.0" right="42.0" top="10.0" />
            </padding>
            <Label styleClass="muted" text="BidNow Desktop | JavaFX 21 | Quản lý vật phẩm Admin" />
        </HBox>
    </bottom>
</BorderPane>
