<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1220.0" style="-fx-background-color: skyblue;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Server.Controller.AdminItemManagementController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-padding: 12;" BorderPane.alignment="CENTER">
            <children>
                <Button mnemonicParsing="false" onAction="#backToAdminDashboard" text="Trở lại" />
                <Label style="-fx-font-size: 20px;" text="Quản lí vật phẩm" />
            </children>
        </HBox>
    </top>

    <center>
        <VBox spacing="8.0" BorderPane.alignment="CENTER">
            <padding><Insets bottom="12.0" left="12.0" right="12.0" top="12.0" /></padding>
            <children>
                <Label style="-fx-font-size: 16px;" text="Tất cả sản phẩm (mọi trạng thái)" />
                <TableView fx:id="table" prefHeight="620.0" prefWidth="1160.0">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="80.0" text="ID" />
                        <TableColumn fx:id="colName" prefWidth="180.0" text="Tên vật phẩm" />
                        <TableColumn fx:id="colOwnerId" prefWidth="110.0" text="ID người bán" />
                        <TableColumn fx:id="colPrice" prefWidth="130.0" text="Giá khởi điểm" />
                        <TableColumn fx:id="colStatus" prefWidth="130.0" text="Trạng thái" />
                        <TableColumn fx:id="colDescription" prefWidth="250.0" text="Mô tả" />
                        <TableColumn fx:id="colReason" prefWidth="250.0" text="Thông tin phản hồi" />
                    </columns>
                </TableView>
                <HBox alignment="CENTER" spacing="8.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#loadAllItems" text="Tải lại" />
                        <Button mnemonicParsing="false" onAction="#goFirstPage" text="Đầu" />
                        <Button mnemonicParsing="false" onAction="#goPrevPage" text="&lt;" />
                        <Label fx:id="lblPageInfo" text="Trang 1 / 1" />
                        <Button mnemonicParsing="false" onAction="#goNextPage" text="&gt;" />
                        <Button mnemonicParsing="false" onAction="#goLastPage" text="Cuối" />
                        <TextField fx:id="txtPageInput" prefWidth="80.0" promptText="Số trang" />
                        <Button mnemonicParsing="false" onAction="#goToPage" text="Di chuyển" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>