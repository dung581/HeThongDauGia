<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1220.0" styleClass="app-root" stylesheets="@bidnow-dark.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Server.Controller.DanhSachDauGiaController">
    <left>
        <VBox prefWidth="250.0" spacing="18.0" styleClass="sidebar">
            <padding>
                <Insets bottom="24.0" left="24.0" right="18.0" top="24.0" />
            </padding>

            <VBox spacing="4.0">
                <Label styleClass="brand" text="BidNow" />
                <Label styleClass="muted" text="Auction Platform" />
            </VBox>

            <VBox spacing="12.0">
                <Label styleClass="section-label" text="TRADING" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goToSessions" styleClass="nav-active" text="Sessions" />
                <Button fx:id="browseItemsNav" maxWidth="Infinity" mnemonicParsing="false" onAction="#goToBrowseItems" styleClass="nav-item" text="Browse Items" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#openSessionDetail" styleClass="nav-item" text="Session Detail" />
            </VBox>

            <VBox spacing="12.0">
                <Label fx:id="accountSectionLabel" styleClass="section-label" text="ACCOUNT" />
                <Button fx:id="accountNavButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#goToAccount" styleClass="nav-item" text="My Account" />
                <Button fx:id="depositNav" maxWidth="Infinity" mnemonicParsing="false" onAction="#goToDeposit" styleClass="nav-item" text="Deposit" />
                <Button fx:id="uploadItemNav" maxWidth="Infinity" mnemonicParsing="false" onAction="#goToUploadItem" styleClass="nav-item" text="Upload Item" />
            </VBox>
        </VBox>
    </left>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="topbar">
            <padding>
                <Insets bottom="16.0" left="32.0" right="32.0" top="16.0" />
            </padding>
            <Label styleClass="muted" text="BidNow / Sessions" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#trolai" styleClass="secondary-button" text="Tro lai" />
        </HBox>
    </top>

    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets bottom="22.0" left="32.0" right="24.0" top="24.0" />
            </padding>

            <VBox spacing="6.0">
                <Label styleClass="page-title" text="Bid Sessions" />
                <Label styleClass="page-subtitle" text="Live auction sessions currently available" />
            </VBox>

            <HBox spacing="14.0">
                <VBox prefHeight="70.0" prefWidth="180.0" spacing="6.0" styleClass="card">
                    <padding><Insets bottom="12.0" left="18.0" right="18.0" top="12.0" /></padding>
                    <Label styleClass="field-name" text="LIVE SESSIONS" />
                    <Label styleClass="danger-value" text="0" />
                </VBox>
                <VBox prefHeight="70.0" prefWidth="180.0" spacing="6.0" styleClass="card">
                    <padding><Insets bottom="12.0" left="18.0" right="18.0" top="12.0" /></padding>
                    <Label styleClass="field-name" text="BIDS TODAY" />
                    <Label styleClass="accent-value" text="0" />
                </VBox>
                <VBox prefHeight="70.0" prefWidth="180.0" spacing="6.0" styleClass="card">
                    <padding><Insets bottom="12.0" left="18.0" right="18.0" top="12.0" /></padding>
                    <Label styleClass="field-name" text="YOUR ACTIVE" />
                    <Label styleClass="success-value" text="0" />
                </VBox>
            </HBox>

            <TableView fx:id="table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="70.0" text="ID" />
                    <TableColumn fx:id="colItemId" prefWidth="110.0" text="Item ID" />
                    <TableColumn fx:id="colItemName" prefWidth="180.0" text="Item Name" />
                    <TableColumn fx:id="colState" prefWidth="110.0" text="State" />
                    <TableColumn fx:id="colStartTime" prefWidth="170.0" text="Start" />
                    <TableColumn fx:id="colEndTime" prefWidth="170.0" text="End" />
                    <TableColumn fx:id="colCurrentPrice" prefWidth="150.0" text="Current Bid" />
                    <TableColumn fx:id="colCurrentUserId" prefWidth="130.0" text="Leader" />
                </columns>
            </TableView>
        </VBox>
    </center>

    <right>
        <VBox prefWidth="300.0" spacing="16.0">
            <padding>
                <Insets bottom="22.0" left="0.0" right="24.0" top="24.0" />
            </padding>

            <VBox spacing="14.0" styleClass="card">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>
                <Label styleClass="page-subtitle" text="SELECTED ITEM" />
                <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #f4f7fb;" text="San pham" />

                <GridPane hgap="12.0" vgap="12.0">
                    <Label styleClass="field-name" text="ID" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Label fx:id="idLabel" styleClass="field-value" text=" " GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label styleClass="field-name" text="TEN" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <Label fx:id="tenLabel" styleClass="field-value" text=" " wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label styleClass="field-name" text="GIA" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <Label fx:id="giaLabel" styleClass="accent-value" text=" " GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label styleClass="field-name" text="TRANG THAI" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <Label fx:id="trangthaiLabel" styleClass="field-value" text=" " GridPane.columnIndex="1" GridPane.rowIndex="3" />
                </GridPane>

                <VBox spacing="6.0">
                    <Label styleClass="field-name" text="THONG TIN" />
                    <Label fx:id="thongtinLabel" minHeight="90.0" styleClass="field-value" text=" " wrapText="true" />
                </VBox>
            </VBox>
        </VBox>
    </right>

    <bottom>
        <HBox alignment="CENTER" spacing="10.0" styleClass="topbar">
            <padding>
                <Insets bottom="10.0" left="24.0" right="24.0" top="10.0" />
            </padding>
            <Button mnemonicParsing="false" onAction="#loadData" styleClass="secondary-button" text="Tai lai" />
            <Button mnemonicParsing="false" onAction="#openSessionDetail" styleClass="primary-button" text="Tham gia ->" />
            <Button mnemonicParsing="false" onAction="#goFirstPage" styleClass="secondary-button" text="Dau" />
            <Button mnemonicParsing="false" onAction="#goPrevPage" styleClass="secondary-button" text="&lt;" />
            <Label fx:id="lblPageInfo" styleClass="field-value" text="Trang 1 / 1" />
            <Button mnemonicParsing="false" onAction="#goNextPage" styleClass="secondary-button" text="&gt;" />
            <Button mnemonicParsing="false" onAction="#goLastPage" styleClass="secondary-button" text="Cuoi" />
            <TextField fx:id="txtPageInput" prefWidth="90.0" promptText="So trang" styleClass="input" />
            <Button mnemonicParsing="false" onAction="#goToPage" styleClass="secondary-button" text="Di chuyen" />
        </HBox>
    </bottom>
</BorderPane>
