<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="760.0" prefWidth="1220.0" style="-fx-background-color: skyblue;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Server.Controller.DanhSachDauGiaController">

    <top>
        <Label style="-fx-font-size: 18px; -fx-padding: 10;" text="Danh sach dau gia" BorderPane.alignment="CENTER" />
    </top>

    <center>
        <TableView fx:id="table" style="-fx-background-color: rgba(255,255,255,0.8); -fx-border-color: #cccccc; -fx-border-radius: 10; -fx-background-radius: 10;">
            <columns>
                <TableColumn fx:id="colId" prefWidth="70" text="ID" />
                <TableColumn fx:id="colItemId" prefWidth="110.0" text="ID vat pham" />
                <TableColumn fx:id="colItemName" prefWidth="147.0" text="Ten vat pham" />
                <TableColumn fx:id="colState" prefWidth="113.0" text="Trang thai" />
                <TableColumn fx:id="colStartTime" prefWidth="118.0" text="Bat dau" />
                <TableColumn fx:id="colEndTime" prefWidth="143.0" text="Ket thuc" />
                <TableColumn fx:id="colCurrentPrice" prefWidth="171.0" text="Gia hien tai" />
                <TableColumn fx:id="colCurrentUserId" prefWidth="66.0" text="ID dat gia" />
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="8" style="-fx-padding: 10;">
            <children>
                <Button mnemonicParsing="false" onAction="#trolai" style="-fx-background-color: linear-gradient(to bottom, #4facfe, #00f2fe);" text="Tro lai" />
            </children>
        </HBox>
    </bottom>

    <right>
        <AnchorPane prefHeight="560.0" prefWidth="280.0" style="-fx-background-color: rgba(255,255,255,0.8); -fx-background-radius: 20; -fx-border-radius: 20;" styleClass="fx" BorderPane.alignment="CENTER">
            <children>
                <Text layoutX="58.0" layoutY="40.0" strokeType="OUTSIDE" strokeWidth="0.0" text="San pham">
                    <font>
                        <Font size="24.0" />
                    </font>
                </Text>
                <Label layoutX="14.0" layoutY="60.0" text="ID:" />
                <Label layoutX="10.0" layoutY="92.0" text="Ten:" />
                <Label layoutX="10.0" layoutY="128.0" text="Gia hien tai:" />
                <Label layoutX="13.0" layoutY="159.0" text="Trang thai:" />
                <Label layoutX="15.0" layoutY="191.0" text="Thong tin:" />
                <TextField fx:id="tiencuoc" layoutX="50.0" layoutY="404.0" promptText="nhap gia tien" style="-fx-background-color: rgba(255,255,255,0.8); -fx-background-radius: 12; -fx-border-color: #cccccc; -fx-border-width: 1; -fx-padding: 10;" />
                <Text layoutX="94.0" layoutY="388.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Dat gia">
                    <font>
                        <Font size="24.0" />
                    </font>
                </Text>
                <Button layoutX="96.0" layoutY="444.0" mnemonicParsing="false" onAction="#submit" style="-fx-background-color: linear-gradient(to bottom, #4facfe, #00f2fe);" text="Xac nhan" />
                <Label fx:id="idLabel" layoutX="53.0" layoutY="61.0" prefHeight="18.0" prefWidth="203.0" text=" " />
                <Label fx:id="tenLabel" layoutX="53.0" layoutY="92.0" prefHeight="18.0" prefWidth="201.0" text=" " />
                <Label fx:id="giaLabel" layoutX="96.0" layoutY="128.0" prefHeight="18.0" prefWidth="166.0" text=" " />
                <Label fx:id="trangthaiLabel" layoutX="96.0" layoutY="159.0" prefHeight="18.0" prefWidth="162.0" text=" " />
                <Label fx:id="thongtinLabel" layoutX="23.0" layoutY="217.0" prefHeight="144.0" prefWidth="218.0" style="-fx-border-color: black; -fx-border-image-width: 2; -fx-border-radius: 5; -fx-padding: 5;" text=" " />
            </children>
        </AnchorPane>
    </right>

</BorderPane>
