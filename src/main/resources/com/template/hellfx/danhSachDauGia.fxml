<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="760.0" prefWidth="1220.0" style="-fx-background-color: skyblue;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Server.Controller.DanhSachDauGiaController">

    <top>
        <Label style="-fx-font-size: 18px; -fx-padding: 10;" text="Danh sách đấu giá" BorderPane.alignment="CENTER" />
    </top>

    <center>
        <TableView fx:id="table">
            <columns>
                <TableColumn fx:id="colId" prefWidth="70" text="ID" />
                <TableColumn fx:id="colItemId" prefWidth="110.0" text="ID vật phẩm" />
                <TableColumn fx:id="colItemName" prefWidth="160.0" text="Tên vật phẩm" />
                <TableColumn fx:id="colState" prefWidth="100.0" text="Trạng thái" />
                <TableColumn fx:id="colStartTime" prefWidth="150.0" text="Bắt đầu" />
                <TableColumn fx:id="colEndTime" prefWidth="150.0" text="Kết thúc" />
                <TableColumn fx:id="colCurrentPrice" prefWidth="140.0" text="Giá hiện tại" />
                <TableColumn fx:id="colCurrentUserId" prefWidth="140.0" text="ID đặt giá" />
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="8" style="-fx-padding: 10;">
            <children>
                <Button mnemonicParsing="false" onAction="#loadData" text="Tải lại" />
                <Button mnemonicParsing="false" onAction="#goFirstPage" text="Đầu" />
                <Button mnemonicParsing="false" onAction="#goPrevPage" text="&lt;" />
                <Label fx:id="lblPageInfo" text="Trang 1 / 1" />
                <Button mnemonicParsing="false" onAction="#goNextPage" text="&gt;" />
                <Button mnemonicParsing="false" onAction="#goLastPage" text="Cuối" />
                <TextField fx:id="txtPageInput" prefWidth="80.0" promptText="Số trang" />
                <Button mnemonicParsing="false" onAction="#goToPage" text="Di chuyển" />
                <Button mnemonicParsing="false" onAction="#trolai" text="Trở lại" />
            </children>
        </HBox>
    </bottom>

    <right>
        <AnchorPane prefHeight="560.0" prefWidth="280.0" BorderPane.alignment="CENTER">
            <children>
                <Text layoutX="58.0" layoutY="40.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Sản phẩm">
                    <font><Font size="24.0" /></font>
                </Text>
                <Label layoutX="14.0" layoutY="60.0" text="ID:" />
                <Label layoutX="10.0" layoutY="92.0" text="Tên:" />
                <Label layoutX="10.0" layoutY="128.0" text="Giá hiện tại:" />
                <Label layoutX="13.0" layoutY="159.0" text="Trạng thái:" />
                <Label layoutX="15.0" layoutY="191.0" text="Thông tin:" />
                <TextField fx:id="tiencuoc" layoutX="50.0" layoutY="404.0" promptText="Nhập giá tiền" />
                <Text layoutX="94.0" layoutY="388.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Đặt giá">
                    <font><Font size="24.0" /></font>
                </Text>
                <Button layoutX="96.0" layoutY="444.0" mnemonicParsing="false" onAction="#submit" text="Xác nhận" />
                <Label fx:id="idLabel" layoutX="53.0" layoutY="61.0" prefHeight="18.0" prefWidth="203.0" text=" " />
                <Label fx:id="tenLabel" layoutX="53.0" layoutY="92.0" prefHeight="18.0" prefWidth="201.0" text=" " />
                <Label fx:id="giaLabel" layoutX="96.0" layoutY="128.0" prefHeight="18.0" prefWidth="166.0" text=" " />
                <Label fx:id="trangthaiLabel" layoutX="96.0" layoutY="159.0" prefHeight="18.0" prefWidth="162.0" text=" " />
                <Label fx:id="thongtinLabel" layoutX="23.0" layoutY="217.0" prefHeight="144.0" prefWidth="218.0" text=" " />
            </children>
        </AnchorPane>
    </right>

</BorderPane>