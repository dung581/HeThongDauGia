<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="636.0" prefWidth="1136.0" style="-fx-background-color: skyblue;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Client.danhSachDauGiaController">

    <top>
        <Label style="-fx-font-size: 18px; -fx-padding: 10;" text="Danh Sách Đấu Giá" BorderPane.alignment="CENTER" />
    </top>

    <center>
        <TableView fx:id="table">
            <columns>
                <TableColumn fx:id="colId" prefWidth="70" text="ID" />
                <TableColumn fx:id="colName" prefWidth="103.0" text="Tên" />
                <TableColumn fx:id="colPrice" prefWidth="105.0" text="Giá" />
                <TableColumn fx:id="colDescription" prefWidth="264.0" text="Thông tin" />
                <TableColumn fx:id="colStatus" prefWidth="109.0" text="Trạng thái" />
            <TableColumn fx:id="colTime" prefWidth="136.0" text="Thời gian kết thức" />
            <TableColumn fx:id="colWiinner" prefWidth="77.0" text="Winner" />
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="10" style="-fx-padding: 10;">
            <Button mnemonicParsing="false" onAction="#loadData" text="Tải Lại" />
            <Button mnemonicParsing="false" onAction="#trolai" text="Trở lại" />
        </HBox>
    </bottom>
   <right>
      <AnchorPane prefHeight="483.0" prefWidth="271.0" style="-fx-background-color: white;" BorderPane.alignment="CENTER">
         <children>
            <Text layoutX="67.0" layoutY="40.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Sản phẩm :">
               <font>
                  <Font size="24.0" />
               </font>
            </Text>
            <Label layoutX="14.0" layoutY="60.0" text="ID :" />
            <Label layoutX="10.0" layoutY="92.0" text="Tên :" />
            <Label layoutX="10.0" layoutY="128.0" text="Giá hiện tại :" />
            <Label layoutX="13.0" layoutY="159.0" text="Trạng thái :" />
            <Label layoutX="15.0" layoutY="191.0" text="Thông tin :" />
            <TextField fx:id="tiencuoc" layoutX="55.0" layoutY="404.0" promptText="nhập giá tiền" style="-fx-background-color: white;" />
            <Text layoutX="96.0" layoutY="388.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Đặt Giá">
               <font>
                  <Font size="24.0" />
               </font>
            </Text>
            <Button layoutX="96.0" layoutY="444.0" mnemonicParsing="false" onAction="#submit" text="Xác nhận" />
            <Label fx:id="idLabel" layoutX="53.0" layoutY="61.0" text="Label" />
            <Label fx:id="tenLabel" layoutX="53.0" layoutY="92.0" text="Label" />
            <Label fx:id="giaLabel" layoutX="96.0" layoutY="128.0" text="Label" />
            <Label fx:id="trangthaiLabel" layoutX="96.0" layoutY="159.0" text="Label" />
            <Label fx:id="thongtinLabel" layoutX="23.0" layoutY="217.0" text="Label" />
         </children>
      </AnchorPane>
   </right>

</BorderPane>
