<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="760.0" prefWidth="1220.0" style="-fx-background-color: skyblue;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Server.Controller.DanhSachDauGiaController">

    <top>
        <Label style="-fx-font-size: 18px; -fx-padding: 10;" text="Danh sach dau gia" BorderPane.alignment="CENTER" />
    </top>

    <center>
        <TableView fx:id="table">
            <columns>
                <TableColumn fx:id="colId" prefWidth="70" text="ID" />
                <TableColumn fx:id="colItemId" prefWidth="110.0" text="ID vat pham" />
                <TableColumn fx:id="colItemName" prefWidth="160.0" text="Ten vat pham" />
                <TableColumn fx:id="colState" prefWidth="100.0" text="Trang thai" />
                <TableColumn fx:id="colStartTime" prefWidth="150.0" text="Bat dau" />
                <TableColumn fx:id="colEndTime" prefWidth="150.0" text="Ket thuc" />
                <TableColumn fx:id="colCurrentPrice" prefWidth="140.0" text="Gia hien tai" />
                <TableColumn fx:id="colCurrentUserId" prefWidth="140.0" text="ID dat gia" />
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="8" style="-fx-padding: 10;">
            <children>
                <Button mnemonicParsing="false" onAction="#trolai" text="Trở Về" />
            <Button mnemonicParsing="false" onAction="#loadAuctionDataAsync" text="Tải Lại" />
            </children>
        </HBox>
    </bottom>

    <right>
        <AnchorPane prefHeight="560.0" prefWidth="280.0" BorderPane.alignment="CENTER">
            <children>
                <Text layoutX="87.0" layoutY="40.0" strokeType="OUTSIDE" strokeWidth="0.0" text="San pham">
                    <font>
                        <Font size="24.0" />
                    </font>
                </Text>
                <Label layoutX="14.0" layoutY="60.0" text="ID:" />
                <Label layoutX="10.0" layoutY="92.0" text="Ten:" />
                <Label layoutX="10.0" layoutY="128.0" text="Gia hien tai:" />
                <Label layoutX="13.0" layoutY="159.0" text="Trang thai:" />
                <Label layoutX="15.0" layoutY="191.0" text="Thong tin:" />
                <Label fx:id="idLabel" layoutX="53.0" layoutY="61.0" prefHeight="18.0" prefWidth="203.0" text=" " />
                <Label fx:id="tenLabel" layoutX="53.0" layoutY="92.0" prefHeight="18.0" prefWidth="201.0" text=" " />
                <Label fx:id="giaLabel" layoutX="96.0" layoutY="128.0" prefHeight="18.0" prefWidth="166.0" text=" " />
                <Label fx:id="trangthaiLabel" layoutX="96.0" layoutY="159.0" prefHeight="18.0" prefWidth="162.0" text=" " />
                <Label fx:id="thongtinLabel" layoutX="23.0" layoutY="217.0" prefHeight="144.0" prefWidth="240.0" text=" " />
            <Button layoutX="89.0" layoutY="387.0" mnemonicParsing="false" text="Tham Gia Phiên" />
            </children>
        </AnchorPane>
    </right>

</BorderPane>
