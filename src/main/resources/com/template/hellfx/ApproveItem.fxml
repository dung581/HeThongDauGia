<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1220.0" styleClass="app-root" stylesheets="@bidnow-dark.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Server.Controller.ApproveController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="topbar">
            <padding>
                <Insets bottom="16.0" left="32.0" right="32.0" top="16.0" />
            </padding>
            <Label styleClass="muted" text="BidNow / Admin / Pending Items" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#trolai" styleClass="secondary-button" text="Tro lai" />
        </HBox>
    </top>

    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets bottom="20.0" left="32.0" right="32.0" top="28.0" />
            </padding>

            <VBox spacing="6.0">
                <Label styleClass="page-title" text="Duyet san pham" />
                <Label styleClass="page-subtitle" text="Chon item dang cho duyet, nhap thoi gian dau gia hoac ly do tu choi." />
            </VBox>

            <TableView fx:id="table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="80.0" text="ID" />
                    <TableColumn fx:id="colName" prefWidth="180.0" text="Ten" />
                    <TableColumn fx:id="colPrice" prefWidth="130.0" text="Gia" />
                    <TableColumn fx:id="colDescription" prefWidth="320.0" text="Thong tin" />
                    <TableColumn fx:id="colDetail" prefWidth="220.0" text="Mo ta" />
                    <TableColumn fx:id="colStatus" prefWidth="160.0" text="Trang thai" />
                </columns>
            </TableView>

            <VBox spacing="12.0">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Button onAction="#onChapNhan" styleClass="primary-button" text="Chap nhan" />
                    <Button onAction="#onTuChoi" styleClass="danger-button" text="Tu choi" />
                    <Button mnemonicParsing="false" onAction="#trolai" styleClass="secondary-button" text="Tro lai" />
                </HBox>

                <VBox fx:id="approvePane" managed="false" spacing="12.0" styleClass="card" visible="false">
                    <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                    </padding>
                    <Label styleClass="section-label" text="THOI GIAN DAU GIA" />
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label styleClass="field-name" text="BAT DAU" />
                        <TextField fx:id="startTime" prefWidth="190.0" promptText="yyyy-MM-dd HH:mm" styleClass="input" />
                        <Label styleClass="field-name" text="KET THUC" />
                        <TextField fx:id="endTime" prefWidth="190.0" promptText="yyyy-MM-dd HH:mm" styleClass="input" />
                    </HBox>
                </VBox>

                <VBox fx:id="rejectPane" managed="false" spacing="12.0" styleClass="card" visible="false">
                    <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                    </padding>
                    <Label styleClass="section-label" text="LY DO TU CHOI" />
                    <TextField fx:id="rejectReason" promptText="Nhap ly do tra ve cho seller" styleClass="input" />
                </VBox>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="topbar">
            <padding>
                <Insets bottom="10.0" left="42.0" right="42.0" top="10.0" />
            </padding>
            <Label styleClass="muted" text="BidNow Desktop | JavaFX 21 | Approval workspace" />
        </HBox>
    </bottom>
</BorderPane>
