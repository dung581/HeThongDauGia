<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: skyblue;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Server.Controller.ApproveController">

    <top>
        <Label style="-fx-font-size: 18px; -fx-padding: 10;" text="Quản lý sản phẩm" BorderPane.alignment="CENTER" />
    </top>

    <center>
        <TableView fx:id="table">
            <columns>
                <TableColumn fx:id="colId" prefWidth="70" text="ID" />
                <TableColumn fx:id="colName" prefWidth="122.0" text="Tên" />
                <TableColumn fx:id="colPrice" prefWidth="100.0" text="Giá" />
                <TableColumn fx:id="colDescription" prefWidth="242.0" text="Thông tin" />
                <TableColumn fx:id="colDetail" prefWidth="120.0" text="Mô tả" />
                <TableColumn fx:id="colStatus" prefWidth="120.0" text="Trạng thái" />
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="10" style="-fx-padding: 10;">
            <children>
                <HBox alignment="CENTER" spacing="10">
                    <children>
                        <Button onAction="#onChapNhan" text="Chấp nhận" />
                        <Button onAction="#onTuChoi" text="Từ chối" />
                        <Button mnemonicParsing="false" onAction="#trolai" text="Trở lại" />
                    </children>
                </HBox>

                <VBox fx:id="approvePane" managed="false" spacing="8" style="-fx-background-color: white; -fx-border-color: #2f6f89; -fx-border-width: 1; -fx-padding: 10; -fx-background-radius: 6; -fx-border-radius: 6;" visible="false">
                    <children>
                        <Label text="Thời gian đấu giá" style="-fx-font-size: 14; -fx-font-weight: bold;" />
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <children>
                                <Label text="Bắt đầu:" />
                                <TextField fx:id="startTime" prefWidth="180" promptText="yyyy-MM-dd HH:mm" />
                                <Label text="Kết thúc:" />
                                <TextField fx:id="endTime" prefWidth="180" promptText="yyyy-MM-dd HH:mm" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox fx:id="rejectPane" managed="false" spacing="8" style="-fx-background-color: white; -fx-border-color: #8a4a4a; -fx-border-width: 1; -fx-padding: 10; -fx-background-radius: 6; -fx-border-radius: 6;" visible="false">
                    <children>
                        <Label text="Lý do từ chối" style="-fx-font-size: 14; -fx-font-weight: bold;" />
                        <TextField fx:id="rejectReason" promptText="Nhập lý do trả về cho seller" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </bottom>

</BorderPane>