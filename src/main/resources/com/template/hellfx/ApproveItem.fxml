<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1220.0" styleClass="app-root" stylesheets="@bidnow-dark.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Server.Controller.ApproveController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="topbar">
            <padding>
                <Insets bottom="16.0" left="32.0" right="32.0" top="16.0" />
            </padding>
            <Label styleClass="muted" text="BidNow / Admin / Vật phẩm chờ duyệt" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#trolai" styleClass="secondary-button" text="Trở lại" />
        </HBox>
    </top>

    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets bottom="20.0" left="32.0" right="32.0" top="28.0" />
            </padding>

            <VBox spacing="6.0">
                <Label styleClass="page-title" text="Duyệt sản phẩm" />
                <Label styleClass="page-subtitle" text="Chọn sản phẩm đang chờ duyệt, nhập thời gian đấu giá hoặc lý do từ chối." />
            </VBox>

            <ListView fx:id="table" styleClass="data-list" VBox.vgrow="ALWAYS" />

            <VBox spacing="12.0">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Button onAction="#onChapNhan" styleClass="primary-button" text="Chấp nhận" />
                    <Button onAction="#onTuChoi" styleClass="danger-button" text="Từ chối" />
                </HBox>

                <VBox fx:id="approvePane" managed="false" spacing="12.0" styleClass="card" visible="false">
                    <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                    </padding>
                    <Label styleClass="section-label" text="THỜI GIAN ĐẤU GIÁ" />
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label styleClass="field-name" text="BẮT ĐẦU" />
                        <TextField fx:id="startTime" prefWidth="190.0" promptText="yyyy-MM-dd HH:mm" styleClass="input" />
                        <Label styleClass="field-name" text="KẾT THÚC" />
                        <TextField fx:id="endTime" prefWidth="190.0" promptText="yyyy-MM-dd HH:mm" styleClass="input" />
                    </HBox>
                </VBox>

                <VBox fx:id="rejectPane" managed="false" spacing="12.0" styleClass="card" visible="false">
                    <padding>
                        <Insets bottom="16.0" left="18.0" right="18.0" top="16.0" />
                    </padding>
                    <Label styleClass="section-label" text="LÝ DO TỪ CHỐI" />
                    <TextField fx:id="rejectReason" promptText="Nhap ly do tra ve cho seller" styleClass="input" />
                </VBox>
            </VBox>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="topbar">
            <padding>
                <Insets bottom="10.0" left="42.0" right="42.0" top="10.0" />
            </padding>
            <Label styleClass="muted" text="BidNow Desktop | JavaFX 21 | Phê duyệt sản phẩm Admin" />
        </HBox>
    </bottom>
</BorderPane>
