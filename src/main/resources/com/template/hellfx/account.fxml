<BorderPane prefHeight="520.0" prefWidth="900.0" style="-fx-background-color: skyblue;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Server.Controller.AccountController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-padding: 12;" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#backToDashboard" text="Quay lai" />
            <Label fx:id="lblTitle" prefHeight="30.0" prefWidth="779.0" text="Thông tin tài khoản                                              Lịch sử đấu giá">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>
         </children>
      </HBox>
   </top>

   <center>
      <VBox spacing="14.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="18.0" left="18.0" right="18.0" top="8.0" />
         </padding>
         <children>
            <TableView prefHeight="720.0" prefWidth="1136.0">
              <columns>
                <TableColumn prefWidth="77.0" text="C1" />
                <TableColumn minWidth="0.0" prefWidth="73.0" text="C2" />
              </columns>
            </TableView>
         </children>
      </VBox>
   </center>
   <left>
      <VBox prefHeight="466.0" prefWidth="256.0" style="-fx-background-color: rgba(255,255,255,0.7); -fx-background-radius: 15; -fx-border-color: #cccccc; -fx-border-image-width: 1; -fx-border-radius: 15;" BorderPane.alignment="CENTER">
