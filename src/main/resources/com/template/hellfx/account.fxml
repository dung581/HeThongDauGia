<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1220.0" styleClass="app-root" stylesheets="@bidnow-dark.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Server.Controller.AccountController">
    <left>
        <VBox prefWidth="250.0" spacing="18.0" styleClass="sidebar">
            <padding>
                <Insets bottom="24.0" left="24.0" right="18.0" top="24.0" />
            </padding>

            <VBox spacing="4.0">
                <Label styleClass="brand" text="BidNow" />
                <Label styleClass="muted" text="Auction Platform" />
            </VBox>

            <VBox spacing="12.0">
                <Label styleClass="section-label" text="NAVIGATION" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goHome" styleClass="nav-item" text="Home" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goToSessions" styleClass="nav-item" text="Sessions" />
                <Button fx:id="browseItemsNav" maxWidth="Infinity" mnemonicParsing="false" onAction="#goToBrowseItems" styleClass="nav-item" text="Browse Items" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goToAccount" styleClass="nav-active" text="My Account" />
            </VBox>

            <VBox spacing="12.0">
                <Label styleClass="section-label" text="ACCOUNT" />
                <Button fx:id="depositNav" maxWidth="Infinity" mnemonicParsing="false" onAction="#goToDeposit" styleClass="nav-item" text="Deposit" />
                <Button fx:id="uploadItemNav" maxWidth="Infinity" mnemonicParsing="false" onAction="#goToUploadItem" styleClass="nav-item" text="Upload Item" />
            </VBox>
        </VBox>
    </left>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="topbar">
            <padding>
                <Insets bottom="16.0" left="32.0" right="32.0" top="16.0" />
            </padding>
            <Label styleClass="muted" text="BidNow / My Account" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#backToDashboard" styleClass="secondary-button" text="Tro lai" />
        </HBox>
    </top>

    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets bottom="22.0" left="32.0" right="24.0" top="24.0" />
            </padding>

            <VBox spacing="6.0">
                <Label fx:id="lblTitle" styleClass="page-title" text="Thong tin tai khoan" />
                <Label styleClass="page-subtitle" text="Theo doi so du, tien dang khoa va lich su stake cua tai khoan." />
            </VBox>

            <HBox fx:id="accountSummaryPane" spacing="14.0">
                <VBox prefHeight="78.0" prefWidth="220.0" spacing="6.0" styleClass="card">
                    <padding><Insets bottom="12.0" left="18.0" right="18.0" top="12.0" /></padding>
                    <Label styleClass="field-name" text="TONG SO DU" />
                    <Label fx:id="lblBalance" styleClass="money-value" text="0" />
                </VBox>
                <VBox prefHeight="78.0" prefWidth="220.0" spacing="6.0" styleClass="card">
                    <padding><Insets bottom="12.0" left="18.0" right="18.0" top="12.0" /></padding>
                    <Label styleClass="field-name" text="TIEN DANG KHOA" />
                    <Label fx:id="lblLocked" styleClass="money-value" text="0" />
                </VBox>
                <VBox prefHeight="78.0" prefWidth="220.0" spacing="6.0" styleClass="card">
                    <padding><Insets bottom="12.0" left="18.0" right="18.0" top="12.0" /></padding>
                    <Label styleClass="field-name" text="SO DU KHA DUNG" />
                    <Label fx:id="lblAvailable" styleClass="money-value" text="0" />
                </VBox>
            </HBox>

            <VBox fx:id="stakePane" spacing="10.0" VBox.vgrow="ALWAYS">
                <Label styleClass="section-label" text="LICH SU STAKE" />
                <TableView fx:id="stakeTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colStakeId" prefWidth="90.0" text="ID" />
                        <TableColumn fx:id="colAuctionId" prefWidth="140.0" text="Auction ID" />
                        <TableColumn fx:id="colItemId" prefWidth="140.0" text="Item ID" />
                        <TableColumn fx:id="colStakeUserId" prefWidth="140.0" text="User ID" />
                        <TableColumn fx:id="colAmount" prefWidth="190.0" text="So tien" />
                        <TableColumn fx:id="colStakeStatus" prefWidth="190.0" text="Trang thai" />
                    </columns>
                </TableView>
            </VBox>

            <VBox fx:id="adminPane" managed="false" spacing="12.0" styleClass="card" visible="false" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                </padding>
                <Label styleClass="section-label" text="DANH SACH TAI KHOAN" />
                <TableView fx:id="adminTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colUserId" prefWidth="80.0" text="User ID" />
                        <TableColumn fx:id="colUsername" prefWidth="150.0" text="Username" />
                        <TableColumn fx:id="colFullname" prefWidth="170.0" text="Fullname" />
                        <TableColumn fx:id="colRole" prefWidth="100.0" text="Role" />
                        <TableColumn fx:id="colPassword" prefWidth="130.0" text="Password" />
                        <TableColumn fx:id="colBalance" prefWidth="140.0" text="Balance" />
                        <TableColumn fx:id="colLocked" prefWidth="140.0" text="Locked" />
                    </columns>
                </TableView>
                <HBox alignment="CENTER" spacing="10.0">
                    <Button mnemonicParsing="false" onAction="#goFirstPage" styleClass="secondary-button" text="Dau" />
                    <Button mnemonicParsing="false" onAction="#goPrevPage" styleClass="secondary-button" text="&lt;" />
                    <Label fx:id="lblPageInfo" styleClass="field-value" text="Trang 1 / 1" />
                    <Button mnemonicParsing="false" onAction="#goNextPage" styleClass="secondary-button" text="&gt;" />
                    <Button mnemonicParsing="false" onAction="#goLastPage" styleClass="secondary-button" text="Cuoi" />
                    <TextField fx:id="txtPageInput" prefWidth="90.0" promptText="So trang" styleClass="input" />
                    <Button mnemonicParsing="false" onAction="#goToPage" styleClass="secondary-button" text="Di chuyen" />
                </HBox>
            </VBox>
        </VBox>
    </center>

    <right>
        <VBox fx:id="userInfoPane" prefWidth="300.0" spacing="16.0">
            <padding>
                <Insets bottom="22.0" left="0.0" right="24.0" top="24.0" />
            </padding>
            <VBox spacing="14.0" styleClass="card">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>
                <Label styleClass="page-subtitle" text="ACCOUNT DETAIL" />
                <GridPane hgap="14.0" vgap="12.0">
                    <Label styleClass="field-name" text="USERNAME" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Label fx:id="lblUsername" styleClass="field-value" text="" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label styleClass="field-name" text="HO TEN" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <Label fx:id="lblFullname" styleClass="field-value" text="" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label styleClass="field-name" text="ROLE" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <Label fx:id="lblRole" styleClass="field-value" text="" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                </GridPane>
            </VBox>
        </VBox>
    </right>

    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="topbar">
            <padding>
                <Insets bottom="10.0" left="42.0" right="42.0" top="10.0" />
            </padding>
            <Label styleClass="muted" text="BidNow Desktop | JavaFX 21 | Account workspace" />
        </HBox>
    </bottom>
</BorderPane>
