            </Text>
            <Label fx:id="lblRole" text=" ">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Tổng số dư :">
               <font>
                  <Font size="18.0" />
               </font>
            </Text>
            <Label fx:id="lblBalance" text="0">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Tiền khoá :">
               <font>
                  <Font size="18.0" />
               </font>
            </Text>
            <Label fx:id="lblLocked" text="0">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Số dư khả dụng :">
               <font>
                  <Font size="18.0" />
               </font>
            </Text>
            <Label fx:id="lblAvailable" text="0">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
         </children>
      </VBox>
