            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Username:">
               <font>
                  <Font size="18.0" />
               </font>
            </Text>
            <Label fx:id="lblUsername">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Họ và Tên :">
               <font>
                  <Font size="18.0" />
               </font>
            </Text>
            <Label fx:id="lblFullname" text=" ">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Vai Trò :">
               <font>
                  <Font size="18.0" />
