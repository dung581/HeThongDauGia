<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1220.0" styleClass="app-root" stylesheets="@bidnow-dark.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Server.Controller.AccountController">
    <left>
        <VBox prefWidth="250.0" spacing="18.0" styleClass="sidebar">
            <padding>
                <Insets bottom="24.0" left="24.0" right="18.0" top="24.0" />
            </padding>

            <VBox spacing="4.0">
                <Label styleClass="brand" text="BidNow" />
                <Label styleClass="muted" text="Auction Platform" />
            </VBox>

            <VBox spacing="12.0">
                <Label styleClass="section-label" text="NAVIGATION" />
                <Button fx:id="accountNavButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#goToAccount" styleClass="nav-active" text="My Account" />
            </VBox>
        </VBox>
    </left>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="topbar">
            <padding>
                <Insets bottom="16.0" left="32.0" right="32.0" top="16.0" />
            </padding>
            <Label fx:id="lblBreadcrumb" styleClass="muted" text="BidNow / My Account" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#backToDashboard" styleClass="secondary-button" text="Tro lai" />
        </HBox>
    </top>

    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets bottom="22.0" left="32.0" right="24.0" top="24.0" />
            </padding>

            <VBox spacing="6.0">
                <Label fx:id="lblTitle" styleClass="page-title" text="Thong tin tai khoan" />
                <Label fx:id="lblSubtitle" styleClass="page-subtitle" text="Theo doi so du, tien dang khoa va lich su stake cua tai khoan." />
            </VBox>

            <HBox fx:id="accountSummaryPane" spacing="14.0">
                <VBox prefHeight="78.0" prefWidth="220.0" spacing="6.0" styleClass="card">
                    <padding><Insets bottom="12.0" left="18.0" right="18.0" top="12.0" /></padding>
                    <Label styleClass="field-name" text="TONG SO DU" />
                    <Label fx:id="lblBalance" styleClass="money-value" text="0" />
                </VBox>
                <VBox prefHeight="78.0" prefWidth="220.0" spacing="6.0" styleClass="card">
                    <padding><Insets bottom="12.0" left="18.0" right="18.0" top="12.0" /></padding>
                    <Label styleClass="field-name" text="TIEN DANG KHOA" />
                    <Label fx:id="lblLocked" styleClass="money-value" text="0" />
                </VBox>
                <VBox prefHeight="78.0" prefWidth="220.0" spacing="6.0" styleClass="card">
                    <padding><Insets bottom="12.0" left="18.0" right="18.0" top="12.0" /></padding>
                    <Label styleClass="field-name" text="SO DU KHA DUNG" />
                    <Label fx:id="lblAvailable" styleClass="money-value" text="0" />
                </VBox>
            </HBox>

            <VBox fx:id="stakePane" spacing="10.0" VBox.vgrow="ALWAYS">
                <Label styleClass="section-label" text="LICH SU STAKE" />
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-bar">
                    <TextField fx:id="stakeSearchField" prefWidth="280.0" promptText="Tim theo auction, item, so tien" styleClass="input" />
                    <ChoiceBox fx:id="stakeStatusFilter" prefWidth="160.0" />
                </HBox>
                <ListView fx:id="stakeTable" styleClass="data-list" VBox.vgrow="ALWAYS" />
            </VBox>

            <VBox fx:id="adminPane" managed="false" spacing="12.0" styleClass="card" visible="false" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                </padding>
                <Label styleClass="section-label" text="DANH SACH TAI KHOAN" />
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-bar">
                    <TextField fx:id="accountSearchField" prefWidth="300.0" promptText="Tim username, ho ten, user ID" styleClass="input" />
                    <ChoiceBox fx:id="accountRoleFilter" prefWidth="160.0" />
                </HBox>
                <ListView fx:id="adminTable" styleClass="data-list" VBox.vgrow="ALWAYS" />
            </VBox>
        </VBox>
    </center>

    <right>
        <VBox fx:id="userInfoPane" prefWidth="300.0" spacing="16.0">
            <padding>
                <Insets bottom="22.0" left="0.0" right="24.0" top="24.0" />
            </padding>
            <VBox spacing="14.0" styleClass="card">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                </padding>
                <Label styleClass="page-subtitle" text="ACCOUNT DETAIL" />
                <GridPane hgap="14.0" vgap="12.0">
                    <Label styleClass="field-name" text="USERNAME" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Label fx:id="lblUsername" styleClass="field-value" text="" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label styleClass="field-name" text="HO TEN" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <Label fx:id="lblFullname" styleClass="field-value" text="" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label styleClass="field-name" text="ROLE" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <Label fx:id="lblRole" styleClass="field-value" text="" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                </GridPane>
            </VBox>
        </VBox>
    </right>

    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="topbar">
            <padding>
                <Insets bottom="10.0" left="42.0" right="42.0" top="10.0" />
            </padding>
            <Label fx:id="lblFooter" styleClass="muted" text="BidNow Desktop | JavaFX 21 | Account workspace" />
        </HBox>
    </bottom>
</BorderPane>
